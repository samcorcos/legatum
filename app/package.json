{
  "name": "legatum-app",
  "private": true,
  "license": "MIT",
  "repository": "github:samcorcos/legatum",
  "homepage": "https://legatum-game.pages.dev",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:hosted": "playwright test -c e2e-hosted/playwright.config.ts",
    "test:watch": "vitest",
    "test:e2e": "LEGATUM_RELAY_URL=http://127.0.0.1:8787 ../scripts/build-web.sh --skip-wasm && playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
