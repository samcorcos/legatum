<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by the Tauri CLI into the generated gen/apple Info.plist (iOS only). -->
<plist version="1.0">
<dict>
	<!-- iPad: landscape only for now; the tablet layout keeps the desktop side panels (plans/mobile.md M1). -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Required to restrict iPad orientations; also opts out of Split View and Slide Over. -->
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
