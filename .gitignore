target/
node_modules/
.DS_Store
.vite/
*.tsbuildinfo
__pycache__/
app/dist/
app/src/wasm-pkg/
app/public/THIRD_PARTY_LICENSES.txt
crates/wasm/pkg/
app/test-results/
app/test-results-webkit/
app/playwright-report/
/test-results/
# Simulation output is large; keep it out of git or store it gzipped.
docs/sim-results/*.json
.env

# Art masters live outside git (tools/art/sources-manifest.json, tools/art/fetch-sources.py): fetched or newly generated
# `*-source.png` rasters and the people/key-art masters stay untracked.
app/src/assets/units/*-source.png
app/src/assets/art/people-[a-z]*[a-z].png
app/src/assets/art/title-keyart-c-road-at-dawn.png

# Local agent and tooling state: worktrees, per-machine settings, queues, review output, hook state.
.claude/worktrees/
.claude/settings.local.json
.claude/hooks/.last-*
.progress/
.reviews/
# Owner-specific scrub patterns for the public-export scans (see .private.example/).
.private/
# Credentials, keys and Terraform state never belong in git.
.env.*
!.env.example
*.pem
*.p8
*.p12
*.tfvars
!example.tfvars
*.tfstate
*.tfstate.*
.terraform/

# Generated by the art gate and app build (tools/art); never commit
tools/art/.cache/
