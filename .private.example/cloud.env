# Per-machine cloud settings: account-specific names and limits that are never written in the repository.
#
# Copy this file to .private/cloud.env (git-ignored) in your main checkout and fill it in. tools/cloud/lib.sh reads
# it for every tools/cloud script, and tools/evolve reads it through lib.sh. A value already set in the environment
# wins. Lines are KEY=value with no quotes and no spaces around the equals sign; only LEGATUM_* keys are read.

# AWS CLI profile holding the sims launcher's access key (infra/cloud-sims/README.md, setup step 4).
# Unset: the AWS CLI's default credential chain (AWS_PROFILE and so on).
LEGATUM_AWS_PROFILE=<launcher-profile>

# AWS CLI profile that may read billing (the launcher may not). Used only to check month-to-date spend before a
# spot launch by the climb program. Unset: that check fails closed, so the program launches no spot servers.
LEGATUM_AWS_ADMIN_PROFILE=<admin-profile>

# Month-to-date spend, in USD, above which the climb program stops launching spot servers. Set it a little below
# your monthly_budget_usd. Unset or 0: no spot.
LEGATUM_MTD_GUARD_USD=<amount>
